# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
# Use the same Gemini model your story_bible_model.py uses. Check it is available to your key.
GEMINI_MODEL=gemini-2.5-flash

# If set, every request (except /health) must send:  X-API-Key: <this value>
API_KEY=

# Local testing without a GPU or Gemini key: fake audio + canned plans.
DEV_FAKE=0

# Tuned settings (variant "B" from the notebook). Change only after listening tests.
CLIP_SECONDS=4
STEPS=30
CFG_SCALE=4.0

MAX_PENDING=20
JOB_TTL_SECONDS=3600
MAX_DURATION_SECONDS=120
